# ===== LLM configuration (required) =====
# Model name (Qwen family on DashScope, e.g. qwen-plus / qwen-flash / qwen-max)
QWEN_MODEL="qwen-plus"
# Your DashScope API key (get one at https://dashscope.console.aliyun.com)
QWEN_API="put-your-API-key-here"
# OpenAI-compatible endpoint (usually no need to change)
QWEN_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# ===== Optional =====
# Default response language: en | zh | auto  (default: en; "auto" mirrors the user).
# Override per run with `--lang`.
# AGENT_LANG="en"
# Bocha web-search API key (only needed if you wire up a web-search tool)
# BOCHA_API_KEY="your-Bocha-API-key"
